<odoo>
    <record id="res_partner_guild_view_list" model="ir.ui.view">
        <field name="name">res.partner.guild.view.list</field>
        <field name="model">res.partner.guild</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="color" widget="color_picker" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>
    <record id="res_partner_guild_view_form" model="ir.ui.view">
        <field name="name">res.partner.guild.view.form</field>
        <field name="model">res.partner.guild</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="color" widget="color_picker" />
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="res_partner_guild_action" model="ir.actions.act_window">
        <field name="name">Guilds</field>
        <field name="res_model">res.partner.guild</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_partner_guild_root"
        name="Guilds"
        parent="contacts.res_partner_menu_config"
    />

    <menuitem
        id="menu_partner_guild"
        name="Guilds"
        parent="menu_partner_guild_root"
        action="res_partner_guild_action"
    />
</odoo>
